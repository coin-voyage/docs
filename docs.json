{
  "$schema": "https://mintlify.com/docs.json",
  "name": "CoinVoyage",
  "description": "CoinVoyage enables seamless crypto payments into your app from any supported chain and coin.",
  "theme": "mint",
  "logo": {
    "light": "/assets/logo-light.svg",
    "dark": "/assets/logo.svg"
  },
  "favicon": "/assets/favicon.ico",
  "colors": {
    "primary": "#d6296f",
    "light": "#e688bd",
    "dark": "#fc1777"
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/coin-voyage"
    },
    "links": [
      {
        "label": "X",
        "href": "https://x.com/Coin_Voyage",
        "icon": "twitter"
      },
      {
        "href": "https://github.com/coin-voyage/",
        "label": "Github"
      }
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/Coin_Voyage"
    }
  },
  "api": {
    "playground": {
      "display": "interactive"
    }
  },
  "navigation": {
    "versions": [
      {
        "version": "v3",
        "default": true,
        "tabs": [
          {
            "tab": "Documentation",
            "groups": [
              {
                "group": "Get started",
                "pages": [
                  "introduction",
                  "flows/overview",
                  "quickstart"
                ]
              },
              {
                "group": "Core concepts",
                "pages": [
                  "concepts/how-it-works",
                  "concepts/pay-orders",
                  "concepts/supported-networks",
                  "concepts/supported-regions"
                ]
              },
              {
                "group": "PayKit",
                "pages": [
                  "sdk/overview",
                  "sdk/walletprovider",
                  "sdk/paykitprovider",
                  "sdk/paybutton",
                  "sdk/useorderstatusws"
                ]
              },
              {
                "group": "SwapKit",
                "pages": [
                  "sdk/swapkit"
                ]
              },
              {
                "group": "Styling / Theme",
                "pages": [
                  "sdk/styling/paykit",
                  "sdk/styling/swapkit"
                ]
              },
              {
                "group": "Invoices",
                "pages": [
                  "invoices/overview",
                  "invoices/api"
                ]
              },
              {
                "group": "API integration",
                "pages": [
                  "api/overview",
                  {
                    "group": "ApiClient reference",
                    "root": "sdk/apiclient",
                    "expanded": false,
                    "pages": [
                      "sdk/apiclient/authentication",
                      "sdk/apiclient/orders",
                      "sdk/apiclient/swaps",
                      "sdk/apiclient/wallets-and-search",
                      "sdk/apiclient/on-ramp",
                      "sdk/apiclient/off-ramp",
                      "sdk/apiclient/invoices",
                      "sdk/apiclient/fees",
                      "sdk/apiclient/webhooks-and-websockets",
                      "sdk/apiclient/types"
                    ]
                  },
                  "resources/rate-limits",
                  "sdk/paykit-headless"
                ]
              },
              {
                "group": "Going live",
                "pages": [
                  "webhooks/overview",
                  "webhooks/events",
                  "guides/production-checklist"
                ]
              },
              {
                "group": "Dashboard",
                "pages": [
                  "dashboard/overview",
                  "dashboard/transactions",
                  "dashboard/settlement",
                  "dashboard/withdrawals",
                  "dashboard/custom-fees",
                  "dashboard/invoices",
                  "dashboard/developers"
                ]
              },
              {
                "group": "Resources",
                "pages": [
                  "resources/pricing",
                  "resources/changelog",
                  "resources/faqs",
                  "resources/support"
                ]
              }
            ]
          },
          {
            "tab": "API reference",
            "icon": "square-terminal",
            "openapi": {
              "source": "https://api.coinvoyage.io/v3/openapi.json",
              "directory": "api-reference"
            }
          }
        ]
      }
    ]
  }
}
