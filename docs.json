{
  "$schema": "https://mintlify.com/docs.json",
  "name": "CoinVoyage",
  "description": "CoinVoyage enables seamless crypto payments into your app from any supported chain and coin.",
  "theme": "mint",
  "logo": {
    "light": "/assets/logo-light.svg",
    "dark": "/assets/logo.svg"
  },
  "favicon": "/assets/favicon.ico",
  "colors": {
    "primary": "#d6296f",
    "light": "#e688bd",
    "dark": "#fc1777"
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/coin-voyage"
    },
    "links": [
      {
        "label": "X",
        "href": "https://x.com/Coin_Voyage",
        "icon": "twitter"
      },
      {
        "href": "https://github.com/coin-voyage/",
        "label": "Github"
      }
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/Coin_Voyage"
    }
  },
  "api": {
    "playground": {
      "display": "interactive"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "introduction",
              "quickstart"
            ]
          },
          {
            "group": "Core concepts",
            "pages": [
              "concepts/how-it-works",
              "concepts/pay-orders",
              "concepts/supported-networks",
              "concepts/supported-regions"
            ]
          },
          {
            "group": "SDK",
            "pages": [
              "sdk/overview",
              "sdk/paykitprovider",
              "sdk/walletprovider",
              "sdk/paybutton",
              "sdk/apiclient"
            ]
          },
          {
            "group": "Webhooks",
            "pages": [
              "webhooks/overview",
              "webhooks/events"
            ]
          },
          {
            "group": "Dashboard",
            "pages": [
              "dashboard/overview",
              "dashboard/transactions",
              "dashboard/settlement",
              "dashboard/withdrawals",
              "dashboard/custom-fees",
              "dashboard/invoices",
              "dashboard/developers"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/production-checklist"
            ]
          },
          {
            "group": "Resources",
            "pages": [
              "resources/pricing",
              "resources/changelog",
              "resources/faqs",
              "resources/support"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "icon": "square-terminal",
        "openapi": {
          "source": "https://api.coinvoyage.io/v2/openapi.json",
          "directory": "api-reference"
        }
      }
    ]
  }
}
